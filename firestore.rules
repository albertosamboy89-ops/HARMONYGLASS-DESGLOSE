rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprints
    function isValidWindowProject(data) {
      return data.keys().hasAll(['id', 'clientName', 'type', 'width', 'height', 'vias', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.clientName is string && data.clientName.size() <= 100
        && data.type in ['P65', 'P92', 'P40', 'VENTILADA', 'GAVETAS']
        && data.width is number && data.height is number
        && data.vias in [2, 3, 4]
        && data.status in ['pending', 'completed']
        && data.createdAt is number;
    }

    function isValidPricing(data) {
      return data.keys().hasAll(['price'])
        && data.price is number;
    }

    // Collection Rules
    match /users/{userId} {
      match /projects/{projectId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(projectId) 
          && isValidWindowProject(request.resource.data);

        allow update: if isOwner(userId)
          && isValidId(projectId)
          && isValidWindowProject(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.id == resource.data.id;

        allow delete: if isOwner(userId);
      }

      match /pricing/{clientId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(clientId) && (request.method == 'create' || request.method == 'update') && isValidPricing(request.resource.data);
      }
    }
  }
}
