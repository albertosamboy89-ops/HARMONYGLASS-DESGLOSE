rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Entity Validations (does not require active request.auth)
    function isValidProject(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.clientName is string && data.clientName.size() <= 200
        && data.type in ['P65', 'P92', 'VENTILADA', 'GAVETAS', 'PUERTA_COMERCIAL', 'COCINA_MODULAR']
        && data.width is number && data.width > 0
        && data.height is number && data.height > 0
        && data.vias is number && data.vias >= 1 && data.vias <= 6
        && data.status in ['pending', 'completed']
        && data.createdAt is number
        && data.userId == userId;
    }

    function isValidPricing(data, userId) {
      return data.id is string
        && data.userId == userId
        && data.pricing is map;
    }

    // User Data Match - matching users by dynamic clientId/userId
    match /users/{userId} {
      match /projects/{projectId} {
        allow get, list, delete: if true;
        
        allow create: if true 
          && projectId is string && projectId.size() <= 128
          && isValidProject(request.resource.data, userId)
          && request.resource.data.id == projectId;
          
        allow update: if true
          && isValidProject(request.resource.data, userId);
      }
      
      match /pricing/{pricingId} {
        allow read: if true;
        allow write: if true && isValidPricing(request.resource.data, userId);
      }
    }
  }
}
