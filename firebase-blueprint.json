{
  "entities": {
    "WindowProject": {
      "title": "Window Project",
      "description": "Details of a window production order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "clientName": { "type": "string" },
        "type": { "type": "string", "enum": ["P65", "P92", "P40", "VENTILADA", "GAVETAS"] },
        "width": { "type": "number", "description": "Width in sixteenths" },
        "height": { "type": "number", "description": "Height in sixteenths" },
        "vias": { "type": "number", "enum": [2, 3, 4] },
        "results": {
          "type": "object",
          "properties": {
            "marco": { "type": "array", "items": { "$ref": "#/definitions/CutDetail" } },
            "hojas": { "type": "array", "items": { "$ref": "#/definitions/CutDetail" } },
            "vidrios": { "type": "array", "items": { "$ref": "#/definitions/CutDetail" } }
          }
        },
        "completedCuts": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "number" },
        "deliveryDate": { "type": "string" }
      },
      "required": ["id", "clientName", "type", "width", "height", "vias", "status", "createdAt"]
    },
    "CutDetail": {
      "title": "Cut Detail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "piece": { "type": "string" },
        "qty": { "type": "number" },
        "size": { "type": "number" },
        "formula": { "type": "string" },
        "dimensions": { "type": "string" }
      }
    },
    "ClientPricing": {
      "title": "Client Pricing",
      "type": "object",
      "properties": {
        "price": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/projects/{projectId}": {
      "schema": "WindowProject",
      "description": "User's window production projects"
    },
    "/users/{userId}/pricing/{clientId}": {
      "schema": "ClientPricing",
      "description": "Pricing per square foot for each client"
    }
  }
}
